# Meet backend — server-only environment variables
#
# Copy this file to `.env.local` for local development and configure the
# corresponding variables in Vercel Preview/Production. Never commit `.env.local`
# and never prefix any of these values with NEXT_PUBLIC_ — they MUST remain
# server-only.
#
# Required groups per openspec/PRDs/backend.md section 10.1.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public base URL used to build absolute action/OAuth redirect URLs.
APP_BASE_URL=https://nahuelnoir.vercel.app

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only)
# ---------------------------------------------------------------------------

# Firebase project identifier.
FIREBASE_PROJECT_ID=

# Service account client email (looks like xxx@<project>.iam.gserviceaccount.com).
FIREBASE_CLIENT_EMAIL=

# Service account private key. Keep the `\n` escape sequences as-is in the
# Vercel variable editor; the app converts them to real newlines at runtime.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------

# Resend API key (server-only). Temporary sender until a domain is verified.
RESEND_API_KEY=

# Recipient for simple lead/meeting notifications sent to Nahuel.
CONTACT_TO_EMAIL=

# From header used by Resend. Temporary sandbox sender by default.
CONTACT_FROM_EMAIL="Nahuel Noir Portfolio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Google Calendar/Meet (primary calendar via personal Google OAuth)
# ---------------------------------------------------------------------------

# OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token obtained ONCE through the protected administrative OAuth flow
# at GET /api/admin/google-oauth/authorize?admin=<ADMIN_SECRET>. After copying
# the returned refresh token into this variable, the temporary administrative
# routes can be disabled or removed.
GOOGLE_REFRESH_TOKEN=

# Primary calendar by default; replace with a specific calendar id later.
GOOGLE_CALENDAR_ID=primary

# Google Calendar Watch channel values. Generate a cryptographically random
# token when registering the watch; never expose these through NEXT_PUBLIC_.
GOOGLE_CALENDAR_WEBHOOK_CHANNEL_ID=
GOOGLE_CALENDAR_WEBHOOK_RESOURCE_ID=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Encryption key for persisted owner-notification retry envelopes. Generate a
# unique high-entropy value; production refuses to seal or unseal without it.
RECOVERY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Temporary administrative OAuth protection
# ---------------------------------------------------------------------------

# Strong one-time secret required by /api/admin/google-oauth/authorize and
# /api/admin/google-oauth/callback (header `x-admin-secret` or `?admin=`).
# Generate a long random value and remove it once the refresh token is stored.
GOOGLE_OAUTH_ADMIN_SECRET=
