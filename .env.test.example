NODE_ENV=test
APP_BASE_URL=http://localhost:3000
FIREBASE_PROJECT_ID=demo-noir-portfolio
# The Firestore emulator uses projectId-only Admin initialization. Do not add
# FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, or GOOGLE_APPLICATION_CREDENTIALS.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
RESEND_API_KEY=
CONTACT_TO_EMAIL=test@example.com
CONTACT_FROM_EMAIL="Test <test@example.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Generated at test runtime; do not place an OAuth admin secret in this file.
GOOGLE_OAUTH_ADMIN_SECRET=
# Optional deterministic test-only recovery key. When blank, tests/emulator use
# a process-random key that is never persisted or used in production.
RECOVERY_TEST_KEY=
GOOGLE_CALENDAR_WEBHOOK_CHANNEL_ID=
GOOGLE_CALENDAR_WEBHOOK_RESOURCE_ID=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=
