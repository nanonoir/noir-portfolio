{
  "name": "noir-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:service": "vitest run tests/service",
    "test:integration": "node tests/scripts/run-firestore-emulator.mjs",
    "test:integration:guard": "node tests/scripts/assert-test-environment.mjs",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:e2e:backend": "node tests/scripts/run-backend-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:focus-check": "node tests/scripts/assert-no-focused-tests.mjs",
    "test:ci": "pnpm test:focus-check && pnpm test:unit && pnpm test:service && pnpm test:api && pnpm test:integration",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:prod": "tsc --project tsconfig.prod.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "firebase-admin": "^14.2.0",
    "googleapis": "^173.0.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@vitest/coverage-v8": "^4.1.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
